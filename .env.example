# Settings for sharectl. Copy to .env and edit; each one is the default for its command option.
# A deployed controller gets these from its manifest instead.

# The PoPs whose controllers run, comma-separated; required. A deployed controller's manifest
# names its own PoP.
SHARECTL_SITE=mombasa
SHARECTL_INVENTORY=inventory
SHARECTL_SCENARIOS=scenarios
SHARECTL_OUT=out
SHARECTL_SIGNAL=signal
# Wall-clock milliseconds per 10 s tick of the simulated clock.
SHARECTL_TICK_MS=20
